{
  "openapi": "3.0.3",
  "info": {
    "title": "Кофейня «Утро» — API заявок",
    "version": "1.0.0",
    "description": "Локальная документация формы заказа. Попытка Try it out отправляет тестовую заявку в подключённый workflow n8n и может добавить строку в таблицу и сообщение в тестовый чат. Используйте только синтетические данные."
  },
  "servers": [
    {
      "url": "https://kakakakaka.app.n8n.cloud/webhook",
      "description": "Production webhook учебного workflow n8n"
    }
  ],
  "paths": {
    "/zayavka": {
      "post": {
        "summary": "Отправить заявку с сайта",
        "operationId": "submitOrder",
        "description": "Принимает JSON с полями формы и запускает цепочку обработки заявки в n8n.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderRequest"
              },
              "example": {
                "name": "Гость Swagger",
                "phone": "+7 900 000-00-42",
                "zakaz": "Тестовый заказ",
                "kommentariy": "Проверка API",
                "website": ""
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Workflow обработал заявку"
          },
          "429": {
            "description": "Сервис ограничил частоту запросов. Учитывайте Retry-After и проверьте, не была ли заявка уже обработана.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "string"
                },
                "description": "Сколько секунд ждать перед следующей попыткой, если сервер вернул этот заголовок."
              }
            }
          },
          "default": {
            "description": "Ошибка запроса или обработки в n8n. Проверьте выполнение workflow до повтора."
          }
        }
      }
    },
    "/hello": {
      "get": {
        "tags": [
          "Локальный пример"
        ],
        "summary": "Проверить GET endpoint",
        "description": "Локальный тестовый маршрут Swagger. Не вызывает n8n и не создаёт заявку.",
        "operationId": "helloWorld",
        "servers": [
          {
            "url": "http://localhost:8000",
            "description": "Локальный сервер разработки"
          }
        ],
        "responses": {
          "200": {
            "description": "Успешный ответ Hello World",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Hello, world!"
                    }
                  }
                },
                "example": {
                  "message": "Hello, world!"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OrderRequest": {
        "type": "object",
        "required": [
          "name",
          "phone",
          "zakaz"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Гость Swagger"
          },
          "phone": {
            "type": "string",
            "example": "+7 900 000-00-42"
          },
          "zakaz": {
            "type": "string",
            "example": "Тестовый заказ"
          },
          "kommentariy": {
            "type": "string",
            "example": "Проверка API"
          },
          "website": {
            "type": "string",
            "description": "Скрытое honeypot-поле; для обычной заявки оставить пустым.",
            "example": ""
          }
        }
      }
    }
  }
}
